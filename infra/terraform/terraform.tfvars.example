project_id = "polar-verity-robertmx23-2026"
region     = "us-central1"

# Pin the image that has been tested. Replace only with a new digest after its
# build and local validation are recorded.
container_image = "us-central1-docker.pkg.dev/polar-verity-robertmx23-2026/polar-assistant/sport-assistant@sha256:bd952e4c6c74eb5d8db9e0398d64904deaf526bb2ca9d32e35f51d173054f24d"

# Keep this empty unless access must be granted at service level. Never use
# allUsers or allAuthenticatedUsers for this QA service.
service_invokers = []

# IAP protects every ingress path, including the default run.app URL. Set this
# only after the Google Auth Platform/OAuth client is configured for this
# project. Add explicit Google users or a Google Group; never grant all users.
enable_iap        = true
iap_access_members = ["user:authorized-user@gmail.com"]
