# Local Google Cloud ADC mode. Run `gcloud auth application-default login`.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
POLAR_ACCESSLINK_CLIENT_ID=
POLAR_ACCESSLINK_CLIENT_SECRET=
POLAR_ACCESSLINK_ACCESS_TOKEN=
POLAR_ACCESSLINK_USER_ID=
POLAR_DEMO_SESSION_PATH=data/demo_polar_session.json
POLAR_DATA_SOURCE=demo
POLAR_ACCESSLINK_SESSION_URL=https://www.polaraccesslink.com/v3/exercises/{session_id}
ADK_MEMORY_MODE=local
# demo is the safe default; full_simulation is only for local HITL audit tests.
GYM_COACH_AGENT_MODE=demo
# Optional: directory mounted read-only in the Cloud Run QA container.
# POLAR_FIT_DIR=/mounts/polar-fit
# Optional future Agent Engine deployment; leave blank for Cloud Run QA.
GOOGLE_CLOUD_AGENT_ENGINE_ID=
